{
  "name": "xiaoke-tracker",
  "productName": "小柯機器人專案追蹤工具",
  "version": "1.1.1",
  "description": "小柯機器人專案追蹤工具：表格、看板、路線圖、自訂欄位、迭代、自動化工作流程、洞察圖表、Google 雲端同步、OpenAI AI 助手、語音文字說明、自動更新",
  "main": "src/main/main.js",
  "author": {
    "name": "吳玉柱",
    "email": "achir1015@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.mjs test/query.test.mjs test/sync.test.mjs test/agent.test.mjs",
    "e2e": "node e2e/smoke.mjs",
    "icon": "python scripts/make_icon.py",
    "dist:win": "electron-builder --win nsis --x64 --publish never && electron-builder --win portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "mobile": "node scripts/build-mobile.mjs",
    "android": "python android/build.py"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.15.6",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "com.achir.xiaoketracker",
    "productName": "小柯機器人專案追蹤工具",
    "artifactName": "XiaokeTracker-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 吳玉柱",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "XiaokeTracker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小柯機器人專案追蹤工具",
      "uninstallDisplayName": "小柯機器人專案追蹤工具",
      "language": "1028",
      "installerLanguages": [
        "zh_TW"
      ]
    },
    "portable": {
      "artifactName": "XiaokeTracker-${version}-win-x64-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "-"
    },
    "dmg": {
      "title": "小柯機器人專案追蹤工具 ${version}"
    },
    "npmRebuild": false
  }
}
